# Per-family runtime cache (SQLite — favourites/notes/listing-cache).
# In production this lives on a Railway Volume mount (VEHICLE_DB_PATH),
# so the local file stays purely a dev artifact and is never committed.
user-*/cache.db

# Images USED to be gitignored when they were fetched on-demand at dev
# time, but they ship with the deploy now so Railway containers don't
# depend on Wikimedia being up at boot. ~20MB total — committed.
